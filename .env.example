# Repository-level environment template.
# Copy to `.env` (gitignored) and fill in.
#
# This one file serves both:
#   - the backend, which reads it directly (and a `backend/.env` after it, which wins)
#   - `docker compose`, which reads it for ${...} interpolation
# Real exported environment variables override both.

# Directory where session JSON files are persisted by the backend.
# Production (docker-compose): bound to the `archery-data` named volume at /data.
# Local dev outside Docker:    override to a writable path, e.g. ./local-data
DATA_DIR=/data

# Host path containing `update-application-dock-docker.sh` (used by the Settings
# "Update applications" button). Set to the absolute path on the host machine.
# When unset, the Settings button shows "Update not available" (graceful degradation).
# Example: HOST_SCRIPTS_DIR=/home/jake/scripts
HOST_SCRIPTS_DIR=/scripts

# JWT secret key — required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ── Google Maps (optional; Listies place columns and the map pane) ────────────
# With either key unset, the `place` column type and the map are unavailable
# and the rest of the app is unaffected.
#
# Enable in Google Cloud: "Places API (New)" and "Maps JavaScript API".
#
# Server-side only — proxied through our API, never sent to the browser.
# Restrict this key by IP address.
GOOGLE_MAPS_SERVER_KEY=
# Handed to the SPA at runtime to render the map. It reaches the browser by
# design, so restrict it by HTTP referrer.
GOOGLE_MAPS_BROWSER_KEY=

