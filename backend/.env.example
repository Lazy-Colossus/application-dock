# Directory where session JSON files are stored.
# In Docker: defaults to /data, mounted as a named volume (archery-data).
# Outside Docker (local dev): override to a writable path, e.g. ./local-data
DATA_DIR=/data

# JWT secret key — required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
